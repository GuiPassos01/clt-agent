# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Se der 503 ("high demand"), troque por gemini-3.5-flash
GEMINI_MODEL=gemini-3.8-flash

# Servidor MCP do rag-kit (no rag-kit: bun run mcp:http)
RAG_KIT_MCP_URL=http://127.0.0.1:3001/mcp
RAG_KIT_COLLECTION=clt

# Webhook do n8n chamado ao fim de cada resposta: POST JSON { email, status, message, detail }.
# done: message = resposta, detail = pergunta. error: message = texto da tela, detail = erro original.
# Use a Production URL (/webhook/...) com o workflow ativo; a /webhook-test/ só vale com "Listen for test event" ligado.
# Vazio = não chama.
N8N_WEBHOOK_URL=
N8N_NOTIFY_EMAIL=
# Valor do header "api-key" (credencial Header Auth do nó Webhook). Vazio = não manda o header.
N8N_WEBHOOK_API_KEY=
